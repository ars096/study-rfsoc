# ---- Vivado の生成物（すべて再生成できる）----
build/
build-*/
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.sim/
*.xpr
*.xsa

# ---- ビットストリームとハンドオフ ----
# 固定した版 + このリポジトリから再生成できる。
# 配布したい特定リリースは GitHub Releases か別途の共有フォルダで扱う。
*.bit
*.hwh
*.ltx
*.bin

# ---- ライセンス・秘密情報（万一置いても入らないように）----
*.lic
.Xilinx/

# ---- 取得データ（再取得できる。大きい）----
*.npy
proj*/data/

# ---- OS / エディタ ----
.DS_Store
*~
.vscode/

# ---- Python ----
__pycache__/
*.pyc

# ---- Jupyter ----
.ipynb_checkpoints/
